{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Dark",
  "settings": {
    "color": {
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#15171a" },
        { "slug": "ink", "name": "Ink", "color": "#eceef0" },
        { "slug": "muted", "name": "Muted", "color": "#a9afb8" },
        { "slug": "border", "name": "Border", "color": "#33373d" },
        { "slug": "surface", "name": "Surface", "color": "#1e2126" },
        { "slug": "accent", "name": "Accent", "color": "#7ba7d9" },
        { "slug": "accent-text", "name": "Accent Text", "color": "#8fb4e0" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--accent-text)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--accent)", "text": "#0b0d0f" },
        "border": { "radius": "8px" }
      },
      "heading": { "color": { "text": "var(--wp--preset--color--ink)" } }
    }
  }
}
