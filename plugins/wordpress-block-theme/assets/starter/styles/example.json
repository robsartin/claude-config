        { "slug": "paper", "name": "Paper", "color": "#fbf7ef" },
        { "slug": "ink", "name": "Ink", "color": "#221b12" },
        { "slug": "muted", "name": "Muted", "color": "#5c5346" },
        { "slug": "border", "name": "Border", "color": "#e6ddcf" },
        { "slug": "surface", "name": "Surface", "color": "#efe7d8" },
        { "slug": "accent", "name": "Accent", "color": "#8a5a12" },
        { "slug": "accent-text", "name": "Accent Text", "color": "#7a4f10" }
